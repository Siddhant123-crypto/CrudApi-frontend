  "patterns": [
    {
      "pattern": "^#[0-9a-fA-F]{3,8}$",
      "reason": "Hex color code"
    },
    {
      "pattern": "^rgba?\\([0-9,\\s\\.]+\\)$",
      "reason": "RGB/RGBA color code"
    },
    {
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "reason": "Numeric literal"
    },
    {
      "pattern": "^[0-9]+(\\.[0-9]+)?\\s*(kg|g|km|%|₹|x|m|cm|mm)$",
      "reason": "Numeric measure literal"
    },
    {
      "pattern": "^[A-Za-z0-9_\\-\\.]+\\.(png|jpg|jpeg|gif|webp|svg|mp4)$",
      "reason": "Asset or media file path"
    },
    {
      "pattern": "^https?://",
      "reason": "URL or endpoint string"
    },
    {
      "pattern": "^@farm2home_",
      "reason": "AsyncStorage key prefix"
    },
    {
      "pattern": "^[a-z0-9\\-]+:[a-z0-9\\-]+",
      "reason": "URI scheme or icon name"
    },
    {
      "pattern": "^\\\\+[0-9]+$",
