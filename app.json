{
  "expo": {
    "name": "Farm2Home",
    "slug": "farm2home",
    "scheme": "farm2home",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/farm2home-final-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05290F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.siddhant.farm2home",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD13KSxPnYEtZ88mV6F1CMq-5fLepvbuzQ"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/farm2home-app-icon.png",
        "backgroundColor": "#0B4B20"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Farm2Home to use your location for live order tracking."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e9032626-e058-4cc0-b64d-194bffb76699"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e9032626-e058-4cc0-b64d-194bffb76699"
    }
  }
}
